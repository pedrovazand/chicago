# Token da página Bot no Discord Developer Portal. Preencha apenas no .env.
DISCORD_TOKEN=
# Application ID da página General Information.
DISCORD_APPLICATION_ID=
# ID do servidor de testes (guild).
DISCORD_GUILD_ID=

# Espelho que respondeu às consultas públicas na inspeção inicial.
# Sem troca automática de host nem repetição de requisições.
RONE_API_BASE_URL=https://arena.fastapicloud.dev/api

# Preenchidas localmente por npm run db:setup, sem imprimir segredos.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=
# Banco separado, usado somente pelos testes de integração.
TEST_DATABASE_URL=
# 32 bytes aleatórios em hexadecimal. Preserve a chave para ler sessões existentes.
RONE_TOKEN_ENCRYPTION_KEY=
